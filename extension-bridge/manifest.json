{
  "manifest_version": 3,
  "name": "NotiVas Canvas Bridge",
  "version": "1.0.0",
  "description": "Enlace local de sesion entre Canvas LMS y NotiVas Web",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.utp.edu.pe/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://joxquin.github.io/NotiVas-KMP/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "notivas-bridge@joxquin.me",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
